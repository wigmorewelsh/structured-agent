mod tdd

use extern_fns::read_file
use extern_fns::write_file
use extern_fns::list_directory
use extern_fns::grep
use extern_fns::execute_command
use supervisor::ask_for_supervisor_help

fn is_all_tests_passing(): Boolean {
    "Are all tests currently passing?"!
}

fn is_test_failing_correctly(test_name: String): Boolean {
    test_name!
    "Is this test failing for the right reason - not a syntax error or wrong assertion?"!
}

fn is_impl_stuck(): Boolean {
    "Have you been unable to make progress after multiple attempts at making this test pass?"!
}

fn is_refactor_done(): Boolean {
    "Is the code clean, duplication removed, names clear, and all tests still passing?"!
}

fn write_failing_test(test_description: String): String {
    test_description!
    '''
    Write one failing test for this behaviour. Do NOT write any implementation code.
    The test must fail when run. Consider the right API, extending existing APIs where appropriate.
    Return the test name.
    '''!
}

fn make_test_pass_loop(test_name: String): String {
    let action = select {
        read_file(_),
        list_directory(_),
        grep(_, _, _, _, _),
        write_file(_, _),
        execute_command(_)
    }
    action!

    if is_impl_stuck() {
        let guidance = ask_for_supervisor_help("Cannot make ${test_name} pass. Supervisor input needed:")
        guidance!
    }

    if is_all_tests_passing() {
        return "All tests passing after implementing ${test_name}"
    } else {
        return make_test_pass_loop(test_name)
    }
}

fn make_test_pass(test_name: String): String {
    test_name!
    "Write only enough implementation to make ${test_name} pass. Do not over-engineer. Run tests after each change."!
    return make_test_pass_loop(test_name)
}

fn refactor_loop(): () {
    let action = select {
        read_file(_),
        list_directory(_),
        grep(_, _, _, _, _),
        write_file(_, _),
        execute_command(_)
    }
    action!

    if is_refactor_done() {
        return ()
    } else {
        return refactor_loop()
    }
}

fn refactor(changes: String): () {
    changes!
    "Refactor the changed code. Remove duplication, improve names. Do not change behaviour. Run tests after each change."!
    refactor_loop()
}

fn fix_test_until_failing_correctly(test: String): String {
    let test_name = write_failing_test(test)
    execute_command("run tests")!
    if is_test_failing_correctly(test_name) {
        return test_name
    } else {
        test_name!
        "Fix the test so it fails for the right reason before implementing."!
        return fix_test_until_failing_correctly(test)
    }
}

fn implement_test(test: String): () {
    let test_name = fix_test_until_failing_correctly(test)
    let changes = make_test_pass(test_name)
    refactor(changes)
}

fn create_test_list(plan: String): List<String> {
    plan!
    '''
    From this plan, produce a minimal ordered list of test cases to implement.
    Each entry is one sentence describing exactly one test.
    '''!
}

fn summarize_stage(plan: String): String {
    plan!
    "Summarize: what was implemented, what tests were added, what files changed, and any deviations from the plan."!
}

## Use to implement any feature or bugfix using strict RED-GREEN-REFACTOR.
## Writes a failing test first, makes it pass with minimal code, then refactors. No production code without a failing test first.
pub fn tdd_impl(plan: String): String {
    '''
    You are implementing using strict TDD: RED-GREEN-REFACTOR.
    NO production code without a failing test first.
    If you wrote code before a test, delete it and start over.
    '''!
    plan!

    let test_list = create_test_list(plan)

    for test in test_list.iter() {
        implement_test(test)
    }

    return summarize_stage(plan)
}
