use messaging::receive
use io::print

extern fn read_file(path: String): String
extern fn write_file(path: String, content: String): String
extern fn list_directory(path: String): String
extern fn grep(regex: String, working_directory: String, include_pattern: String, case_sensitive: Boolean, offset: Int): String
extern fn copy_path(source_path: String, destination_path: String): String
extern fn execute_command(command: String): String

## Ask user for more information if there isn't enough context
fn ask_for_more_info(prompt: String): String {
    print(prompt)
    let response = receive()
    return response
}

## **overrides** the file path with the content, WARNING this replaces existing content!
fn write_file_content(path: String, content: String): String {
    write_file(path, content)
    return "Success"
}

fn edit_content(existing_content: String): String {
    "Given the existing content, what should be the new content?"!
    existing_content!
}

## edits a file by reading the file, applying the current task as an edit, then overwriting the file
fn edit_file(filename: String): String {
    let content = read_file(filename)
    let new_content = edit_content(content)
    write_file(filename, new_content)

    return "Completed editing file"
}

fn is_task_complete(): Boolean {
    "Is the task complete?"!
}

fn summarize(): String {
    # it looks like this function is breaking reporting in normal loops
    '''
    Summarize what has been done and why.
    Add a list of files changed.
    What has been learnt that can be applied in the future.
    '''!
}

fn plan_sub_tasks(task_description: String): List<String> {
    "create sub tasks for `${task_description}`"!
}

fn summarize_sub_task(progress_report: String, task_summary: String): String {
    progress_report!
    "Create an updated progress_report with the recently completed task_summary"!
    task_summary!
}

## Break a large task or project up into smaller sub tasks and work on them each in isolation.
## Use task_description to give a the high level task to brake down and work on.
fn sub_tasks(task_description: String): String {
    let plan = plan_sub_tasks(task_description)

    let progress_report = ""
    for sub_task in plan.iter() {
        sub_task!

        let summary = agent_loop(20)
        progress_report = summarize_sub_task(progress_report, summary)
    }

    return progress_report
}

## When a task or feature is too large to work on in one sequential process use this to perform the work in a sub-agent and return a summary of the work
## Use the content param to give the sub-agent context on what to work on, this should be a description of the task or feature to work on and any relevant information to complete the task.
fn sub_process(content: String): String {
    content!

    return agent_loop(20)
}


fn make_report(context: String): String {
    context!
}

## A tool for writing up reports for the user to review.
## Should be used when the user assigned task is complete.
## The user may then respond asking for more detail.
## Takes content to report on as a parameter. This should be a description of what the report should contain.
fn report_to_user(content: String): String {
    let report = make_report(content)
    print(report)
    let user_response = receive()
    return user_response
}

## A tool for thinking through problems, brainstorming ideas, or planning without executing any actions.
## Use this tool when you need to work through complex problems, develop strategies, or outline approaches before taking action.
## Takes content to think about as a parameter. This should be a description of what to think about or a problem to solve.
fn thinking(content: String): String {
    content!
}

fn agent_loop(turns_remaining: Int): String {

    if turns_remaining.equal(0) {
        return summarize()
    }

    let result = select {
        edit_file(_),
        read_file(_),
        write_file_content(_, _),
        list_directory(_),
        grep(_, _, _, _, _),
        copy_path(_, _),
        execute_command(_),
        ask_for_more_info(_),
        thinking(_),
        report_to_user(_),
        sub_tasks(_),
        sub_process(_)
    }

    result!

    if is_task_complete() {
        return summarize()
    } else {
        return agent_loop(turns_remaining.subtract(1))
    }
}

## use when needing to think for longer on what to do
fn plan(): String {
    '''
    Given the task above where should I start?
    What are the high level actions without implementation detail?

    What can I do? And what can I gain by doing so?
    '''!
}

fn update_history(task_summary: String): String {
    '''
    Combine the history with whats been done in the most recent task_summary
    to create an updated record of whats been done.
    Keep the list short but with relavant details.
    Combine the list of lessons learnt to refer to later.
    '''!

    task_summary!

}

fn user_response(task_summary: String): String {
    '''
    The user set a task to work on and the agent has provided a task_summary detailing what has been done.
    Respond to the user giving an update on the task.
    Note if it was successful or if there were any issues.
    If there were issues, ask the user for more information to resolve them.
    '''!
    task_summary!
}

fn main(): () {
    '''
    You are running as a structured agent, the process is defined in a programing language that you dont have access to.
    You will be asked to SELECT between actions/tools/functions to respond to a users query or task.
    At no other point can you call tools.
    Youll have to decide what to use in a given context.
    '''!

    print("Starting agent loop...")

    let history = read_file("history.md")

    while true {
        history!

        let task = receive()
        task!

        plan()!

        let task_summary = agent_loop(20)

        let response = user_response(task_summary)
        print(response)

        history = update_history(task_summary)
        write_file("history.md", history)
    }
}
