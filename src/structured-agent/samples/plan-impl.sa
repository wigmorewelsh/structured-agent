
# phase 1. discuss with the user (interactive back and forth)
# phase 2. plan/impl/verify loop
# phase 2a. plan then the top level agent reviews (loop if more work needed)
# phase 2b. have an agent implement (if the agent fails

fn process(): () {

    let stages = high_level_plan()

    '''
    for each stage run a sub agent to plan out the work,
    check the plan means the expected top level plan,
    then another sub agent to implement the work.
    after the stage is complete commit to git using a one line commit message.
    '''
    for stage in stages {
        let stage_plan = planner_agent(stage)
        let result = impl_agent(stage_plan)
        commit_with_single_message(result)
    }
}

fn high_level_plan(): List<String> {
    '''
    write up a plan inc test list for the Absolute use imports.
    split it into deliverable chunks of value that can be built and tested independently.
    '''
}

fn project_context(): String {
    '''
    You are generating a description of the current project.
    What does it do what? What is it for? What are the major components?
    What tech does it use?
    '''
}

fn planner_agent(stage: String): String {
    '''
    You are planning implementation work for {a language runtime written in Rust.}
    Do NOT implement anything — produce a precise, ordered list of file changes and test cases only.

    ## Context

    {project context}

    '''

}

