fn process(): () {

    let stages = high_level_plan()

    for stage in stages {
        let stage_plan = planner_agent(stage)
        let result = ""
        if check_plan(stage_plan, stage) {
            result = impl_agent(stage_plan)
        }
        
        
    }
}

