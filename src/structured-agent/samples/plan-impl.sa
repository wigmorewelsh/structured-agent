fn test_driven_process(): () {
    # NOTE: Need to track the files changes

    # create test plan
    let test_list = create_initial_test_list()

    for test in test_list {
        implement_test(test)
    }
}

fn create_initial_test_list(): List<String> {
    '''
    create a list of tests that would be needed to verify the Absolute use imports feature.
    '''
}

fn implement_test(test: String): () {
    let test_name = write_failing_test(test)
    let changes = make_test_pass(test_name)
    refactor(changes)
}

fn write_failing_test(test_description: String): String {
    '''
    Write a single test for {test_description} that fails.
    Do not write any implementation code.
    Consider the right API for the {test_description}.
    Extend the existing API if there is already one to build on top of.
    '''!
    test_description!
}
